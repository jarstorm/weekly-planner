SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=                                  # Settings → Database → Connect → Session pooler (URI, IPv4). Solo para migraciones (DDL) — ver sección 0.8. Nunca se usa para queries normales. La conexión directa (db.<ref>.supabase.co) es IPv6-only y falla en redes/entornos sin salida IPv6 — usar siempre el session pooler.
SUPABASE_ANON_KEY=
GROQ_API_KEY=                                  # temporal en vez de Anthropic, ver docs/especificaciones-tecnicas.md sección 0.2
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=                             # console.anthropic.com — cuando esté lista, migrar AggregateService.callGroq() a la API de Claude
ANTHROPIC_MODEL=claude-sonnet-5
RESEND_API_KEY=
RESEND_FROM=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
ENABLE_WHATSAPP_CHANNEL=false                  # a true en cuanto la cuenta de Meta esté operativa — controla si aparece como opción en los <select> del frontend (GET /api/channels/enabled)
TELEGRAM_BOT_TOKEN=
ENABLE_TELEGRAM_CHANNEL=true                   # a false para ocultar la opción del frontend sin tocar código (mismo mecanismo que ENABLE_WHATSAPP_CHANNEL)
CHECKIN_TOKEN_SECRET=                          # cualquier string largo random — firma los links de checkin por formulario (sección 3.5)
SURVEY_TOKEN_SECRET=                           # ídem, para los links de la encuesta mensual anónima — secreto propio, distinto de CHECKIN_TOKEN_SECRET
EMAIL_VERIFICATION_TOKEN_SECRET=               # ídem, para el link de verificación de email al registrarse — secreto propio, distinto de los anteriores
PASSWORD_RESET_TOKEN_SECRET=                   # ídem, para el link de "olvidé mi contraseña" — secreto propio, distinto de los anteriores
MEMBER_VERIFY_TOKEN_SECRET=                    # ídem, para el link de verificación de email de un miembro de equipo — secreto propio, distinto de los anteriores
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                         # Dashboard de Stripe → Webhooks → tu endpoint → "Signing secret" (o `stripe listen` en local)
STRIPE_PRICE_EQUIPO=                           # id de precio recurrente (price_...) del Plan Equipo, 49€/mes
STRIPE_PRICE_ORGANIZACION=                     # id de precio recurrente (price_...) del Plan Organización, 149€/mes
PORT=3001
APP_BASE_URL=http://localhost:3000            # URL pública del frontend (Next.js) — usada para CORS y links en emails
APP_ENV=                                       # "production" SOLO en el .env del VPS real — local comparte la misma Supabase que producción, esto evita que el cron de local mande emails a contactos reales (ver EmailChannel.resolveRecipient)
EMAIL_DEV_OVERRIDE_TO=                         # fuera de producción, TODOS los emails salen hacia aquí en vez del contacto real (vacío = no se manda nada) — poner tu propio email para poder ver el contenido en local
